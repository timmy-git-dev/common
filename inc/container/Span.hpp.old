#pragma once
#include "generic/Debug.hpp"
#include "type/Int.hpp"
#include "type/Trait.hpp"

namespace cmn::container
{
    /// A light template-wrapper around the fixed, contiguous *c-array*, containing **CAPACITY** of **TYPE** elements.
    /// @tparam TYPE The type of elements stored in the *c-array*.
    /// @tparam CAPACITY The amount of elements stored in the *c-array*.
    template<typename TYPE, s64 CAPACITY> class Span
    {
        static_assert(CAPACITY > 0, "A span must have a capacity > 0.");
public:
        /// Default-initializes the **data_** *c-array*, resulting in **CAPACITY** number of **TYPE** elements being default initialized in **O(n)** time.
        constexpr Span();
        /// Moves each given element into the **data_** *c-array* in **O(n)** time.
        /// @tparam _TYPE The type of each element specified. Must match the span's given **TYPE**.
        /// @param  _elements The elements to be moved into the *c-array*.
        template<typename... _TYPE> requires(sizeof...(_TYPE) == CAPACITY) constexpr explicit Span(_TYPE&&... _elements);

        /// Deallocates each element in the span.
        ~Span          (                   ) noexcept = default;
        /// Constructs a copy of all elements in this span.
        Span           (const Span& _copied) noexcept = default;
        /// Constructs a span of moved elements from this span.
        Span           (      Span&& _moved) noexcept = default;
        /// Copies all elements in this span to another.
        Span& operator=(const Span& _copied)          = default;
        /// Moves all elements from this span to another.
        Span& operator=(      Span&& _moved) noexcept = default;

        /// Returns a const reference to an element in the **data_** *c-array* at **_index**.
        /// Asserts when indexed out-of-bounds.
        /// @param _index The index of the returned element from the span.
        /// @returns The readonly-element at **_index** in the span.
        constexpr const TYPE& operator[](s64 _index) const noexcept;
        /// Returns a reference to an element in the **data_** *c-array* at **_index**.
        /// Asserts when indexed out-of-bounds.
        /// @param _index The index of the returned element from the span.
        /// @returns The element at **_index** in the span.
        constexpr       TYPE& operator[](s64 _index)       noexcept;

        /// Returns a const **TYPE** pointer to the first element location in memory, at index 0 in the span.
        /// @returns A readonly-pointer to the first element.
        [[nodiscard]] constexpr const TYPE* begin() const noexcept;
        /// Returns a **TYPE** pointer to the first element location in memory, at index 0 in the span.
        /// @returns A pointer to the first element.
        [[nodiscard]] constexpr       TYPE* begin()       noexcept;
        /// Returns a const **TYPE** pointer to one-past the last element location in memory, at the invalid index **CAPACITY** in the span.
        /// @returns A readonly-pointer to one-past the last element.
        [[nodiscard]] constexpr const TYPE* end  () const noexcept;
        /// Returns a **TYPE** pointer to one-past the last element location in memory, at the invalid index **CAPACITY** in the span.
        /// @returns A pointer to one-past the last element.
        [[nodiscard]] constexpr       TYPE* end  ()       noexcept;

        /// Returns the amount of elements stored in the span.
        /// @returns The size/length of the span.
        [[nodiscard]] constexpr       s64   capacity() const noexcept;
        /// Returns a readonly-pointer to the elements in the span.
        /// @returns A readonly-pointer to the **data_** *c-array*.
        [[nodiscard]] constexpr const TYPE* data    () const noexcept;
        /// Returns a pointer to the elements in the span.
        /// @returns A pointer to the **data_** *c-array*.
        [[nodiscard]] constexpr       TYPE* data    ()       noexcept;
private:
        /// The *c-array* that stores the elements in the span.
        TYPE data_[CAPACITY];
    };

#define TEMPLATE template<typename TYPE, s64 CAPACITY>
#define SPAN Span<TYPE, CAPACITY>

    TEMPLATE constexpr SPAN::Span():
        data_()
    { }

    TEMPLATE template<typename... _TYPE> requires(sizeof...(_TYPE) == CAPACITY) constexpr SPAN::Span(_TYPE&&... _elements):
        data_ { type::forward<_TYPE>(_elements)... }
    { }

    TEMPLATE constexpr const TYPE& SPAN::operator[](s64 _index) const noexcept { ASSERT(_index < CAPACITY, "Attempted to index a span out of bounds."); return data_[_index]; }
    TEMPLATE constexpr       TYPE& SPAN::operator[](s64 _index)       noexcept { ASSERT(_index < CAPACITY, "Attempted to index a span out of bounds."); return data_[_index]; }

    TEMPLATE constexpr const TYPE* SPAN::begin() const noexcept { return data_;            }
    TEMPLATE constexpr       TYPE* SPAN::begin()       noexcept { return data_;            }
    TEMPLATE constexpr const TYPE* SPAN::end  () const noexcept { return data_ + CAPACITY; }
    TEMPLATE constexpr       TYPE* SPAN::end  ()       noexcept { return data_ + CAPACITY; }

    TEMPLATE constexpr       s64   SPAN::capacity() const noexcept { return CAPACITY; }
    TEMPLATE constexpr const TYPE* SPAN::data    () const noexcept { return data_;    }
    TEMPLATE constexpr       TYPE* SPAN::data    ()       noexcept { return data_;    }

#undef TEMPLATE
#undef SPAN
}