#pragma once
#include <generic/Debug.hpp>
#include <container/Array.hpp>

namespace cmn::container
{
    class String : public Array<c08>
    {
public:
        constexpr          String();
        constexpr explicit String(s64 _capacity);
        constexpr explicit String(s64 _capacity, const c08* _characters);
        constexpr explicit String(s64 _capacity, s64 _length, const c08  _character);

        ~String          (                     ) noexcept;
        String           (const String& _copied) noexcept = delete;
        String           (      String&& _moved) noexcept = delete;
        String& operator=(const String& _copied)          = delete;
        String& operator=(      String&& _moved) noexcept = delete;
    };

    constexpr String::String():
        Array()
    { }
    constexpr String::String(s64 _capacity):
        Array(_capacity, 0)
    { }
    constexpr String::String(s64 _capacity, const c08* _characters):
        Array(_capacity, 0)
    {
        for (int _i = 0;; _i++)
        {
            c08 _char = _characters[_i];

            add(_char);
            if (_char == '\0')
                return;
        }

        ASSERT(capacity() >= length(), "The specified capacity must be greater or equal to the amount of specified characters.");
    }
    constexpr String::String(s64 _capacity, s64 _length, const c08 _character):
        Array(_capacity, 0)
    {
        ASSERT(capacity() >= length(), "The specified capacity must be greater or equal to the length.")

        for (int _i = 0; _i < _length; _i++)
            add(_character);
    }

    String::~String() noexcept
    {

    }
}