#pragma once
#include "generic/Debug.hpp"
#include "type/Int.hpp"
#include "type/Trait.hpp"
#include "new"

namespace cmn::container
{
    /// A dynamic, contiguous memory block of **TYPE** elements, which doubles **capacity_** when appending elements and **length_** == **capacity_**.
    /// @tparam TYPE The type of elements stored in the memory block.
    template<typename TYPE> class Array
    {
public:
        /// Constructs an empty, invalid array with no memory allocated and a **capacity_** and **length_** of 0.
        constexpr Array();
        /// Constructs an empty array with a block of memory of size **_capacity**.
        /// @param _capacity The size of the memory block to allocate for elements.
        constexpr Array(const s64 _capacity);
        /// Constructs an array with a block of memory of size **_capacity**, and default-initializes elements up to **_length**.
        /// Asserts if **_capacity** < **_length**.
        /// Rethrows any exception that occurs from constructing, after destructing any constructed elements from 0 -> N.
        /// @param _capacity The size of the memory block to allocate for elements.
        /// @param _length The amount of elements to default-initialize.
        constexpr Array(const s64 _capacity, const s64 _length);
        /// Constructs an array with a block of memory of size **_capacity**, and copy-initailizes elements up to **_length** with the specified **_element**.
        /// Asserts if **_capacity** < **_length**.
        /// Rethrows any exception that occurs from constructing, after destructing any constructed elements from 0 -> N.
        /// @param _capacity The size of the memory block to allocate for elements.
        /// @param _length The amount of elements to copy-initialize to **_element**.
        /// @param _element The element to be copied up to **_length**.
        constexpr Array(const s64 _capacity, const s64 _length, const TYPE& _element);
        /// Constructs an array with a block of memory of size **_capacity**, and emplaces each specified element.
        /// If **_length** > the amount of **_elements**, elements in the array will be default-initialized up to **_length**.
        /// Asserts if **_capacity** < **_length**.
        /// Asserts if **_length** < amount of **_elements**.
        /// Rethrows any exception that occurs from constructing, after destructing any constructed elements from 0 -> N.
        /// @tparam _TYPE The type of **_elements** given, must match **TYPE**.
        /// @param  _capacity The size of the memory block to allocate for elements.
        /// @param  _length The amount of elements to emplace and/or default-initialize.
        /// @param  _elements The elements to emplace into the memory block.
        template<typename... _TYPE> constexpr explicit Array(const s64 _capacity, const s64 _length, _TYPE&&... _elements);

        /// Destructs each element in the array from 0 -> **length_**.
        ~Array          (                    ) noexcept;
        /// Constructs a copy of all elements in this array.
        Array           (const Array& _copied) noexcept = delete; // TODO: Implement.
        /// Constructs a array of moved elements from this array.
        Array           (      Array&& _moved) noexcept = delete; // TODO: Implement.
        /// Copies all elements in this array to another.
        Array& operator=(const Array& _copied) noexcept = delete; // TODO: Implement.
        /// Moves all elements from this array to another.
        Array& operator=(      Array&& _moved) noexcept = delete; // TODO: Implement.

        /// Returns a const reference to an element in the **data_** block at **_index**.
        /// Asserts when **_index** > **length_**.
        /// @param _index The index of the returned element from the array.
        /// @returns The readonly-element at **_index** in the array.
        constexpr const TYPE& operator[](const s64 _index) const noexcept;
        /// Returns a reference to an element in the **data_** block at **_index**.
        /// Asserts when **_index** > **length_**.
        /// @param _index The index of the returned element from the array.
        /// @returns The element at **_index** in the array.
        constexpr       TYPE& operator[](const s64 _index)       noexcept;

        /// If **capacity_** < **_capacity**, the array will be reallocated with the new capacity, and elements up to **length_** will be moved to the new memory block.
        /// @param _capacity The necessary amount of allocated memory to grow the array to.
        constexpr void reserve(const s64 _capacity);
        /// If **capacity_** != **_capacity**, the array will be reallocated with the new capacity, and if shrinking,
        /// any constructed elements past **_capacity** will be destructed, and elements up to **length_** will be moved to the new memory block.
        /// @param _capacity The amount of memory to shrink/grow the array to.
        constexpr void resize (const s64 _capacity);
        /// Copies an element to the end of the array, and increases the **length_** by 1.
        /// Asserts if **length_** >= **capacity_**. e.g: If the array is unable to add an element without resizing.
        /// @param _element The element copied to the end of the list.
        constexpr void add(const TYPE&  _element);
        /// Moves an element to the end of the array, and increases the **length_** by 1.
        /// Asserts if **length_** >= **capacity_**. e.g: If the array is unable to add an element without resizing.
        /// @param _element The element moved to the end of the list.
        constexpr void add(      TYPE&& _element);
        /// Copy-inserts an element into **_index** of the array after shifting the elements including and past **_index** in **O(n - _index)** time, then increases the **length_** by 1.
        /// Asserts if **length_** >= **capacity_**. e.g: If the array is unable to insert an element without resizing.
        /// @param _index   The index to insert the element into.
        /// @param _element The element copy-inserted into the list.
        constexpr void insert(const s64 _index, const TYPE&  _element);
        /// Move-inserts an element into **_index** of the array after shifting the elements including and past **_index** in **O(n - _index)** time, then increases the **length_** by 1.
        /// Asserts if **length_** >= **capacity_**. e.g: If the array is unable to insert an element without resizing.
        /// @param _index   The index to insert the element into.
        /// @param _element The element move-inserted into the list.
        constexpr void insert(const s64 _index,       TYPE&& _element);

        /// Returns a const **TYPE** pointer to the first element location in memory, at index 0 in the array.
        /// @returns A readonly-pointer to the first element.
        [[nodiscard]] constexpr const TYPE* begin() const noexcept;
        /// Returns a **TYPE** pointer to the first element location in memory, at index 0 in the array.
        /// @returns A readonly-pointer to the first element.
        [[nodiscard]] constexpr       TYPE* begin()       noexcept;
        /// Returns a const **TYPE** pointer to one-past the last element location in memory, at the invalid index **length_** in the array.
        /// @returns A readonly-pointer to one-past the last element.
        [[nodiscard]] constexpr const TYPE* end  () const noexcept;
        /// Returns a **TYPE** pointer to one-past the last element location in memory, at the invalid index **length_** in the array.
        /// @returns A pointer to one-past the last element.
        [[nodiscard]] constexpr       TYPE* end  ()       noexcept;

        /// Returns the allocated size of the **data_** block for storing elements. Always >= **length_**.
        /// @returns The allocated; but potentially invalid, elements in **data_**.
        [[nodiscard]] constexpr       s64   capacity() const noexcept;
        /// Returns the amount of valid elements stored in the array.
        /// @returns The count of constructed **TYPE** elements in **data_**.
        [[nodiscard]] constexpr       s64   length  () const noexcept;
        /// Returns a readonly-pointer to the memory block storing the elements in the array.
        [[nodiscard]] constexpr const TYPE* data    () const noexcept;
        /// Returns a pointer to the memory block storing the elements in the array.
        [[nodiscard]] constexpr       TYPE* data    ()       noexcept;
private:
        /// Shifts all elements from **_index** to **length_**, **_amount** slots up the array, and increases **length_** by **_amount**.
        /// This function should only be used to create a gap to insert an element, which leaves [**_index**, **_index** + **_amount**) uninitialized.
        /// Asserts if **length_** + **_amount** > **capacity_**. e.g: If the array is unable to shift all elements up without resizing.
        /// Asserts if **_index** > **length_**.
        /// @param _index The starting index to shift elements.
        /// @param _amount The amount of slots elements
        constexpr void shift_right_(const s64 _index, const s64 _amount);
        /// Shifts all elements from **_index** to **length_**, **_amount** slots down the array, and decreases **length_** by **_amount**.
        /// This function should only be used to fill in a gap from a removed element, and [**_index** - **_amount**, **_index**) should be uninitialized.
        /// Doesn't do anything if **_amount** is 0.
        /// Asserts if **_index** > **length_**.
        /// @param _index The starting index to shift elements.
        /// @param _amount The amount of slots elements
        constexpr void shift_left_(const s64 _index, const s64 _amount);

        /// The allocated size of the **data_** block for storing elements. Always >= **length_**.
        s64   capacity_;
        /// The amount of valid elements in the **data_** block starting from index 0 that are constructed. Always <= **capacity_**.
        s64   length_;
        /// The memory block allocated for elements.
        TYPE* data_;
    };

#define TEMPLATE template<typename TYPE>
#define ARRAY Array<TYPE>

    TEMPLATE constexpr ARRAY::Array():
        capacity_(0),
        length_  (0),
        data_    (nullptr)
    { }
    TEMPLATE constexpr ARRAY::Array(const s64 _capacity):
        capacity_(_capacity),
        length_  (0        ),
        data_    (static_cast<TYPE*>(::operator new(sizeof(TYPE) * _capacity)))
    { }
    TEMPLATE constexpr ARRAY::Array(const s64 _capacity, const s64 _length):
        capacity_(_capacity),
        length_  (0        ),
        data_    (static_cast<TYPE*>(::operator new(sizeof(TYPE) * _capacity)))
    {
        ASSERT(_length <= _capacity, "The specified capacity must be greater or equal to the specified length.");

        try
        {
            // Default-initialize any remaining elements up to _length.
            for (; length_ < _length; length_++)
                new (data_ + length_) TYPE();
        }
        catch (...)
        {
            // Destruct all constructed elements, then catch and rethrow any exception that occurs during construction.
            for (s64 _i = 0; _i < length_; _i++)
                (data_ + _i)->~TYPE();

            ::operator delete(data_);
            data_     = nullptr;
            length_   = 0;
            capacity_ = 0;

            throw;
        }
    }
    TEMPLATE constexpr ARRAY::Array(const s64 _capacity, const s64 _length, const TYPE& _element):
        capacity_(_capacity),
        length_  (0        ),
        data_    (static_cast<TYPE*>(::operator new(sizeof(TYPE) * _capacity)))
    {
        ASSERT(_length <= _capacity, "The specified capacity must be greater or equal to the specified length.");

        try
        {
            // Default-initialize any remaining elements up to _length.
            for (; length_ < _length; length_++)
                new (data_ + length_) TYPE(cmn::type::forward<TYPE>(_element));
        }
        catch (...)
        {
            // Destruct all constructed elements, then catch and rethrow any exception that occurs during construction.
            for (s64 _i = 0; _i < length_; _i++)
                (data_ + _i)->~TYPE();

            ::operator delete(data_);
            data_     = nullptr;
            length_   = 0;
            capacity_ = 0;

            throw;
        }
    }
    TEMPLATE template<typename... _TYPE> constexpr ARRAY::Array(const s64 _capacity, const s64 _length, _TYPE&&... _elements):
        capacity_(_capacity),
        length_  (0        ),
        data_    (static_cast<TYPE*>(::operator new(sizeof(TYPE) * _capacity)))
    {
        ASSERT(_length <= _capacity           , "The specified capacity must be greater or equal to the specified length."          );
        ASSERT(_length >= sizeof...(_elements), "The specified length must be greater or equal to the amount of elements specified.");

        try
        {
            // Emplace each element into the memory block.
            ((new (data_ + length_) TYPE(cmn::type::forward<_TYPE>(_elements)), ++length_), ...);

            // Default-initialize any remaining elements up to _length.
            for (; length_ < _length; length_++)
                new (data_ + length_) TYPE();
        }
        catch (...)
        {
            // Destruct all constructed elements, then catch and rethrow any exception that occurs during construction.
            for (s64 _i = 0; _i < length_; _i++)
                (data_ + _i)->~TYPE();

            ::operator delete(data_);
            data_     = nullptr;
            length_   = 0;
            capacity_ = 0;

            throw;
        }
    }

    TEMPLATE ARRAY::~Array() noexcept
    {
        if (data_ == nullptr) return;

        // Destruct each element from index 0 -> length_, then deallocate the memory block.
        for (s64 _i = 0; _i < length_; _i++)
            (data_ + _i)->~TYPE();

        ::operator delete(data_);
        data_     = nullptr;
        length_   = 0;
        capacity_ = 0;
    }

    TEMPLATE constexpr const TYPE& ARRAY::operator[](s64 _index) const noexcept { ASSERT(_index < length_, "Attempted to index out of bounds."); return data_[_index]; }
    TEMPLATE constexpr       TYPE& ARRAY::operator[](s64 _index)       noexcept { ASSERT(_index < length_, "Attempted to index out of bounds."); return data_[_index]; }

    TEMPLATE constexpr       void  ARRAY::add(const TYPE&  _element) { ASSERT(length_ < capacity_, "Attempted to add an element to a full array."); new (data_ + length_) TYPE(cmn::type::forward<TYPE>(_element)); length_++; }
    TEMPLATE constexpr       void  ARRAY::add(      TYPE&& _element) { ASSERT(length_ < capacity_, "Attempted to add an element to a full array."); new (data_ + length_) TYPE(cmn::type::forward<TYPE>(_element)); length_++; }

    TEMPLATE constexpr       void  ARRAY::insert(const s64 _index, const TYPE&  _element)
    {
        ASSERT(length_ < capacity_, "Attempted to add an element to a full array.");



        new (data_ + _index) TYPE(cmn::type::forward<TYPE>(_element)); length_++;
    }

    TEMPLATE constexpr const TYPE* ARRAY::begin() const noexcept { return data_;           }
    TEMPLATE constexpr       TYPE* ARRAY::begin()       noexcept { return data_;           }
    TEMPLATE constexpr const TYPE* ARRAY::end  () const noexcept { return data_ + length_; }
    TEMPLATE constexpr       TYPE* ARRAY::end  ()       noexcept { return data_ + length_; }

    TEMPLATE constexpr       s64   ARRAY::capacity() const noexcept { return length_; }
    TEMPLATE constexpr       s64   ARRAY::length  () const noexcept { return length_; }
    TEMPLATE constexpr const TYPE* ARRAY::data    () const noexcept { return data_;   }
    TEMPLATE constexpr       TYPE* ARRAY::data    ()       noexcept { return data_;   }

    TEMPLATE constexpr       void  ARRAY::shift_right_(const s64 _index, const s64 _amount)
    {

    }

#undef TEMPLATE
#undef ARRAY
}